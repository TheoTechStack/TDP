7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#C925D1;fontColor=#C925D1;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="726"/><mxPoint x="695" y="387"/></Array></mxGeometry></mxCell><mxCell id="c31" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="505" width="24" height="24" as="geometry"/></mxCell><mxCell id="c32" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="395" width="24" height="24" as="geometry"/></mxCell><mxCell id="c33" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="352" y="505" width="24" height="24" as="geometry"/></mxCell><mxCell id="c34" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="585" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="c35" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#C925D1;fontColor=#C925D1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="236"/></Array></mxGeometry></mxCell><mxCell id="c36" value="secrets injected at start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1111" y="310"/><mxPoint x="558" y="310"/></Array></mxGeometry></mxCell><mxCell id="c37" value="stdout logs (both tasks)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#5A6B86;fontColor=#5A6B86;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="752"/><mxPoint x="1050" y="626"/></Array></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;How a request flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Browser calls the ALB's public DNS name over HTTP.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Traffic enters the VPC through the internet gateway.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; ALB health-checks &lt;font face='Menlo'&gt;/health/live&lt;/font&gt; and spreads requests across both tasks (two AZs).&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The task serves the Vue app or handles &lt;font face='Menlo'&gt;/api&lt;/font&gt;, reading and writing Postgres.&lt;br&gt;&lt;br&gt;&lt;b&gt;Security groups chain:&lt;/b&gt; internet → ALB :80 → app :8080 → DB :5432. Nothing else is open.&lt;br&gt;&lt;font color='#DD344C'&gt;- - -&lt;/font&gt; secrets &amp;nbsp; &lt;font color='#C925D1'&gt;- - -&lt;/font&gt; image pull &amp;nbsp; &lt;font color='#5A6B86'&gt;- - -&lt;/font&gt; logs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#D5DBE3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1065" y="760" width="370" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deploy-flow" name="2 · Deploy flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="830" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Transactions Dispute Portal — how a change ships&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#5A6B86'&gt;One command from a clean git tree: &lt;font face='Menlo'&gt;./scripts/deploy.sh&lt;/font&gt; · CI runs separately on every push&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1300" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Continuous integration&lt;/b&gt; · every push to GitHub" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#C8D1DC;fillColor=#F7F9FB;fontColor=#232F3E;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1400" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;git commit + push" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/git/F05032;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="44" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;TheoTechStack/TDP" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/github/181717;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;API job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;dotnet build + test&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;xUnit · Moq · Testcontainers&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/dotnet/512BD4;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="44" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Web job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;vitest · vue-tsc · vite build&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/vuedotjs/4FC08D;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Image job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;docker build (no push)&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/docker/2496ED;" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="44" height="44" as="geometry"/></mxCell><mxCell id="c9" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="GitHub Actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="both green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Deploy&lt;/b&gt; · &lt;font face='Menlo'&gt;./scripts/deploy.sh&lt;/font&gt; from the developer's machine" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#C8D1DC;fillColor=#F7F9FB;fontColor=#232F3E;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1400" height="320" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;deploy.sh&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;refuses a dirty tree&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;TAG = git SHA&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/gnubash/4EAA25;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;-target ECR repo&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/terraform/844FBA;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;docker build&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;linux/arm64 (Graviton)&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;multi-stage → chiseled&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/docker/2496ED;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;ECR push&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;dispute-portal:&amp;lt;sha&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;immutable tags · scanned&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="715" y="396" width="52" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;new task definition&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;VPC · ALB · RDS · IAM …&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/terraform/844FBA;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;ECS rolling deploy&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;min 100% / max 200%&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;circuit breaker + rollback&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1145" y="396" width="52" height="52" as="geometry"/></mxCell><mxCell id="c20" value="① ensure ECR repo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="② build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="③ push :sha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="④ apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="⑤ roll out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;When each new task starts&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="80" y="515" width="400" height="20" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;DB password + JWT key&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="120" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Migrations&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;versioned SQL under&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;an advisory lock&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="400" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Demo seed&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;idempotent, also locked&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="680" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;ALB health check&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;/health/live → healthy&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="960" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Old tasks drained&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;deregistration 15s&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1240" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Safety rails&lt;/b&gt;&lt;br&gt;• Image tags are immutable git SHAs, so every running task maps to an exact commit.&lt;br&gt;• Two healthy tasks are kept while new ones start (min 100%), so deploys don't cause downtime.&lt;br&gt;• If new tasks fail health checks, the ECS circuit breaker rolls back to the previous task definition.&lt;br&gt;• Migrations only add (forward-only SQL), and an advisory lock means only one task runs them.&lt;br&gt;• Tear down everything: &lt;font face='Menlo'&gt;terraform -chdir=infra/terraform destroy&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#D5DBE3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1400" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
