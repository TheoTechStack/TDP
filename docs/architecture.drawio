7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#C925D1;fontColor=#C925D1;dashed=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="726"/><mxPoint x="695" y="387"/></Array></mxGeometry></mxCell><mxCell id="c31" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="505" width="24" height="24" as="geometry"/></mxCell><mxCell id="c32" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="395" width="24" height="24" as="geometry"/></mxCell><mxCell id="c33" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="352" y="505" width="24" height="24" as="geometry"/></mxCell><mxCell id="c34" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="585" y="343" width="24" height="24" as="geometry"/></mxCell><mxCell id="c35" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#C925D1;fontColor=#C925D1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="236"/></Array></mxGeometry></mxCell><mxCell id="c36" value="secrets injected at start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1111" y="310"/><mxPoint x="558" y="310"/></Array></mxGeometry></mxCell><mxCell id="c37" value="stdout logs (both tasks)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#5A6B86;fontColor=#5A6B86;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="752"/><mxPoint x="1050" y="626"/></Array></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;How a request flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Browser calls the ALB's public DNS name over HTTP.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Traffic enters the VPC through the internet gateway.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; ALB health-checks &lt;font face='Menlo'&gt;/health/live&lt;/font&gt; and spreads requests across both tasks (two AZs).&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The task serves the Vue app or handles &lt;font face='Menlo'&gt;/api&lt;/font&gt;, reading and writing Postgres.&lt;br&gt;&lt;br&gt;&lt;b&gt;Security groups chain:&lt;/b&gt; internet → ALB :80 → app :8080 → DB :5432. Nothing else is open.&lt;br&gt;&lt;font color='#DD344C'&gt;- - -&lt;/font&gt; secrets &amp;nbsp; &lt;font color='#C925D1'&gt;- - -&lt;/font&gt; image pull &amp;nbsp; &lt;font color='#5A6B86'&gt;- - -&lt;/font&gt; logs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#D5DBE3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1065" y="760" width="370" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deploy-flow" name="2 · Deploy flow (CI/CD)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Transactions Dispute Portal — how a change ships&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#5A6B86'&gt;Push to main → tests → deploy. No AWS keys in GitHub; Terraform state in S3. &lt;font face='Menlo'&gt;./scripts/deploy.sh&lt;/font&gt; is the same script in CI and on a laptop.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;GitHub Actions&lt;/b&gt; · workflow CI/CD · every push and pull request" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#C8D1DC;fillColor=#F7F9FB;fontColor=#232F3E;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1420" height="200" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;git push" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/git/F05032;" vertex="1" parent="1"><mxGeometry x="80" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;TheoTechStack/TDP" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/github/181717;" vertex="1" parent="1"><mxGeometry x="260" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;api job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;dotnet test&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;xUnit · Moq · Testcontainers&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/dotnet/512BD4;" vertex="1" parent="1"><mxGeometry x="470" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;web job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;vitest · vue-tsc · build&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/vuedotjs/4FC08D;" vertex="1" parent="1"><mxGeometry x="690" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;image job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;docker build&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/docker/2496ED;" vertex="1" parent="1"><mxGeometry x="910" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;deploy job&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;main only · env production&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;optional manual approval&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/githubactions/2088FF;" vertex="1" parent="1"><mxGeometry x="1150" y="165" width="44" height="44" as="geometry"/></mxCell><mxCell id="c10" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="all green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Pull requests run the same tests and stop before deploy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6B86;" vertex="1" parent="1"><mxGeometry x="470" y="262" width="360" height="20" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;AWS access&lt;/b&gt; · created once by &lt;font face='Menlo'&gt;infra/bootstrap&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#C8D1DC;fillColor=#F7F9FB;fontColor=#232F3E;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1420" height="165" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;OIDC token → STS&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;GitHub proves who it is&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;no stored AWS keys&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1155" y="410" width="44" height="44" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;IAM role tdp-github-deploy&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;trust: repo:TheoTechStack/TDP&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;environment:production only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="860" y="410" width="44" height="44" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;S3 tdp-tfstate-376834080760&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;versioned · encrypted · TLS-only&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;use_lockfile (no overlapping applies)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="520" y="410" width="44" height="44" as="geometry"/></mxCell><mxCell id="c20" value="id-token: write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="187"/><mxPoint x="1290" y="432"/></Array></mxGeometry></mxCell><mxCell id="c21" value="AssumeRoleWithWebIdentity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Terraform state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#7AA116;fontColor=#7AA116;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;./scripts/deploy.sh&lt;/b&gt; · runs as tdp-github-deploy (or your own credentials as a fallback)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#C8D1DC;fillColor=#F7F9FB;fontColor=#232F3E;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="1420" height="300" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;terraform init&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;backend = S3 bucket&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/terraform/844FBA;" vertex="1" parent="1"><mxGeometry x="80" y="575" width="44" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;-target ECR repo&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/terraform/844FBA;" vertex="1" parent="1"><mxGeometry x="290" y="575" width="44" height="44" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;docker build&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;linux/arm64 runner&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;skipped if tag exists&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/docker/2496ED;" vertex="1" parent="1"><mxGeometry x="500" y="575" width="44" height="44" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;ECR push&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;dispute-portal:&amp;lt;sha&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;immutable · scanned&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="715" y="571" width="52" height="52" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;terraform apply&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;new task definition&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;VPC · ALB · RDS · IAM …&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;image=https://cdn.simpleicons.org/terraform/844FBA;" vertex="1" parent="1"><mxGeometry x="930" y="575" width="44" height="44" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;ECS rolling deploy&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;min 100% / max 200%&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;circuit breaker + rollback&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1150" y="571" width="52" height="52" as="geometry"/></mxCell><mxCell id="c30" value="temporary credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="882" y="492"/><mxPoint x="102" y="492"/></Array></mxGeometry></mxCell><mxCell id="c31" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;When each new task starts&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="400" height="20" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;DB password + JWT key&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="36" height="36" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Migrations&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;SQL under an advisory lock&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="36" height="36" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Demo seed&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;idempotent, locked&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;" vertex="1" parent="1"><mxGeometry x="680" y="720" width="36" height="36" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;ALB health check&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;/health/live → healthy&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="960" y="720" width="36" height="36" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Old tasks drained&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo, monospace' color='#5A6B86' style='font-size:9px'&gt;then job summary + URL&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="1240" y="720" width="36" height="36" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Safety rails&lt;/b&gt;&lt;br&gt;• Only &lt;font face='Menlo'&gt;TheoTechStack/TDP&lt;/font&gt; in the &lt;font face='Menlo'&gt;production&lt;/font&gt; environment can assume the deploy role; forks and PRs cannot.&lt;br&gt;• Deploys wait for every test, queue instead of overlapping, and are never cancelled mid-apply (state lock stays clean).&lt;br&gt;• Image tags are immutable git SHAs; every running task maps to an exact commit.&lt;br&gt;• ECS keeps two healthy tasks during a rollout and rolls back automatically if new ones fail health checks.&lt;br&gt;• Fallback: the same script runs from a laptop with the same S3 state if GitHub is unavailable." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeColor=#D5DBE3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1420" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
